@baseUrl = http://localhost:8080
@token = replace-with-login-token

### 用户注册
POST {{baseUrl}}/api/v1/user/register
Accept-Language: en-US
Content-Type: application/json

{
    "displayName": "Http Client Test",
    "username": "http-client-test-user",
    "email": "http@client.test",
    "password": "http-client-test-password"
}

### 当前用户（需有效会话）
GET {{baseUrl}}/api/v1/user/me
Accept-Language: en-US
Authorization: Bearer {{token}}

### 发送邮箱验证码（未验证用户可访问）
POST {{baseUrl}}/api/v1/user/email/verify/send
Accept-Language: zh-CN
Authorization: Bearer {{token}}

### 校验邮箱验证码
POST {{baseUrl}}/api/v1/user/email/verify
Accept-Language: zh-CN
Authorization: Bearer {{token}}
Content-Type: application/json

{
    "code": "123456"
}
