@baseUrl = http://localhost:8080
@token = replace-with-login-token

### 用户注册
POST {{baseUrl}}/api/v1/user/register
Accept-Language: en-US
Content-Type: application/json

{
    "displayName": "Http Client Test",
    "username": "http-client-test-user",
    "email": "http@client.test",
    "password": "http-client-test-password"
}

### 当前用户（需有效会话）
GET {{baseUrl}}/api/v1/user/me
Accept-Language: en-US
Authorization: Bearer {{token}}
